{
  "$schema": "./packages-config.schema.json",
  "packages": {
    "dashlane-cli": {
      "type": "github",
      "repo": "Dashlane/dashlane-cli"
    },
    "tuneperfect": {
      "type": "github",
      "repo": "ZerNico/tuneperfect"
    },
    "ultrastar-play": {
      "type": "github",
      "repo": "UltraStar-Deluxe/Play"
    },
    "karere": {
      "type": "git",
      "url": "https://github.com/tobagin/karere.git",
      "tag_regex": "^v\\d+\\.\\d+\\.\\d+$",
      "vars": {
        "_cefver": {
          "type": "upstream_file",
          "file": "packaging/io.github.tobagin.karere.yml",
          "regex": "releases/download/cef-([0-9.]+)-proprietary-codecs/"
        },
        "_cefdir": {
          "type": "upstream_file",
          "file": "packaging/io.github.tobagin.karere.yml",
          "decode": "url",
          "regex": "/(cef_binary_[^/\\s]*_linux64_minimal)\\.zip"
        }
      }
    },
    "karedi": {
      "type": "github",
      "repo": "Nianna/Karedi"
    },
    "jellyfin2samsung-bin": {
      "type": "github",
      "repo": "Jellyfin2Samsung/Samsung-Jellyfin-Installer"
    },
    "open-dungeon-master-client-bin": {
      "type": "github",
      "repo": "Lebbitheplow/open-dungeon-master-client",
      "tag_regex": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "gnome-tuner": {
      "type": "git",
      "url": "https://altlinux.space/alt-gnome/tuner.git",
      "tag_regex": "^\\d+\\.\\d+\\.\\d+$"
    },
    "gnome-tuner-network": {
      "type": "git",
      "url": "https://gitlab.eterfund.ru/ximperlinux/tuner-network.git",
      "tag_regex": "^\\d+\\.\\d+\\.\\d+-alt\\d+$",
      "version_regex": "^(\\d+\\.\\d+\\.\\d+)-alt\\d+$",
      "vars": {
        "_tag": {
          "type": "template",
          "value": "{tag}"
        }
      }
    }
  }
}
