{
  "$schema": "./packages-config.schema.json",
  "packages": {
    "dashlane-cli": {
      "type": "github",
      "repo": "Dashlane/dashlane-cli"
    },
    "tuneperfect": {
      "type": "github",
      "repo": "ZerNico/tuneperfect"
    },
    "ultrastar-play": {
      "type": "github",
      "repo": "UltraStar-Deluxe/Play"
    },
    "karere": {
      "type": "github",
      "repo": "tobagin/karere",
      "tag_regex": "^v\\d+\\.\\d+\\.\\d+$",
      "use_tags": true,
      "vars": {
        "_cefver": {
          "type": "upstream_file",
          "file": "Cargo.lock",
          "regex": "name = \"cef\"\\nversion = \"[^+\"]+\\+([0-9.]+)\""
        },
        "_cefdir": {
          "type": "release_asset",
          "tag": "cef-{_cefver}-proprietary-codecs",
          "asset_regex": "^cef_binary_{_cefver}\\+.*_linux64_minimal\\.zip$",
          "strip": ".zip"
        }
      }
    },
    "karedi": {
      "type": "github",
      "repo": "Nianna/Karedi"
    },
    "jellyfin2samsung-bin": {
      "type": "github",
      "repo": "Jellyfin2Samsung/Samsung-Jellyfin-Installer"
    },
    "open-dungeon-master-client-bin": {
      "type": "github",
      "repo": "Lebbitheplow/open-dungeon-master-client",
      "tag_regex": "^v\\d+\\.\\d+\\.\\d+$"
    }
  }
}
