# Maintainer: Rodrigo Tavares
_pkgname=tuneperfect
pkgname=${_pkgname}-bin
pkgver=0.5.3
pkgrel=1
pkgdesc="Tune Perfect game"
arch=('x86_64')
url="https://github.com/ZerNico/${_pkgname}"
license=('MIT')
provides=("${_pkgname}")
conflicts=("${_pkgname}-git")
depends=(
  'alsa-lib'
  'cairo'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libsoup3'
  'pango'
  'webkit2gtk-4.1'
)

source_x86_64=(
  "https://github.com/ZerNico/${_pkgname}/releases/download/v${pkgver}/Tune.Perfect_${pkgver}_amd64.deb"
  "https://raw.githubusercontent.com/ZerNico/${_pkgname}/master/LICENSE"
)
sha256sums_x86_64=('b22e015d8afcb14fb4c592d1d8f716dd29ce4379c3a68c74e04c57a089586eca' 'SKIP')

options=(!strip)

package() {
  # The .deb's data member is data.tar.xz (not .gz), so match whatever it is.
  bsdtar -C "${pkgdir}" -xf data.tar.*

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}