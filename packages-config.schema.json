{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "Packages Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": true,
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9\\-_.]+$": {
          "oneOf": [
            {
              "additionalProperties": false,
              "required": ["type", "repo"],
              "properties": {
                "type": {
                  "enum": ["github"]
                },
                "repo": {
                  "type": "string",
                  "pattern": "^(?!-)[a-zA-Z0-9\\-]{1,39}\\/(?![_\\-\\.])[a-zA-Z0-9_\\-\\.]{1,100}$",
                  "examples": ["owner/repo"]
                },
                "tag_regex": {
                  "type": "string",
                  "description": "Optional regex pattern to filter tags when checking for new releases"
                },
                "use_tags": {
                  "type": "boolean",
                  "description": "Also consider matching git tags, not just releases; picks the highest version"
                },
                "vars": {
                  "type": "object",
                  "description": "PKGBUILD variables derived from the upstream repository at the new version. Resolved in order; strings can use {pkgver}, {tag} and earlier variables as {name}",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["type", "file", "regex"],
                        "properties": {
                          "type": { "enum": ["upstream_file"] },
                          "file": {
                            "type": "string",
                            "description": "File in the upstream repository, read at the new version's tag"
                          },
                          "regex": {
                            "type": "string",
                            "description": "Regex whose first capture group is the value"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["type", "tag", "asset_regex"],
                        "properties": {
                          "type": { "enum": ["release_asset"] },
                          "tag": {
                            "type": "string",
                            "description": "Tag of the upstream release holding the asset"
                          },
                          "asset_regex": {
                            "type": "string",
                            "description": "Regex that must match exactly one asset name"
                          },
                          "strip": {
                            "type": "string",
                            "description": "Suffix to remove from the asset name"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
